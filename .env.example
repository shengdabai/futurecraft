# FutureCraft environment variables
# Copy this file to .env.local (frontend) and configure the server-side
# variables in your Vercel project settings. Never commit real values.

# ---- Frontend (Vite, exposed to the browser) ----
# Base URL the frontend uses to reach the backend API. Defaults to "/api".
VITE_API_BASE_URL=/api

# ---- Backend (Vercel Serverless Functions, server-side only) ----
# Google Gemini API key used by the AI proxy. Required for AI features.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Comma-separated list of origins allowed by CORS.
# Defaults to https://zturnsgo.com when unset.
ALLOWED_ORIGINS=https://zturnsgo.com

# Optional GetNote knowledge-retrieval integration (gaokao handlers).
# Both URL and token must be set for the integration to run; otherwise it is skipped.
GETNOTES_URL=YOUR_GETNOTES_WEBHOOK_URL_HERE
GETNOTES_TOKEN=YOUR_GETNOTES_TOKEN_HERE
